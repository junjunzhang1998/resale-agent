# Copy to .env. Never commit .env.

# eBay Browse API, PRODUCTION keyset (App ID + Cert ID): https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: buyer ZIP used to price shipping (default 10027)
EBAY_BUYER_ZIP=

# SerpApi (Google Shopping engine), free plan works: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Gemini on Vertex AI. No key: run `gcloud auth application-default login` locally;
# Cloud Run uses its service account. Gemini 3.5 models are served from the global location.
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global

# Optional: disk cache for API responses (default ./cache, 6 hours)
CACHE_DIR=
CACHE_TTL_HOURS=
